# Gmail app password for buildwithanie@gmail.com (contact form)
SMTP_PASS=
# Gemini API key from Google AI Studio for the CancerCare assistant (chatbot). Leave blank to use offline answers only.
GEMINI_API_KEY=
# Optional Gemini model override for the assistant (default gemini-3.8-flash)
CHAT_MODEL=
# Cloudflare Turnstile spam protection (both needed to switch it on)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional: Cloudflare Web Analytics token (or enable Web Analytics in the Pages dashboard instead)
VITE_CF_ANALYTICS_TOKEN=
